# Copy this file to .env and fill in real values. Never commit .env.

# Google AI Studio key (free tier works): https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Pinecone key: https://app.pinecone.io -> API Keys
PINECONE_API_KEY=your-pinecone-api-key-here

# Pinecone index settings (the ingest script creates the index if it is missing)
PINECONE_INDEX_NAME=legixo-takehome
PINECONE_NAMESPACE=corpus
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Models (defaults shown; override only if needed).
# gemini-flash-latest is an alias that works on both older and newer free-tier
# accounts (some models, e.g. gemini-2.5-flash, are unavailable to new accounts).
# NOTE: free-tier quotas are per DAY, per MODEL, per Google Cloud PROJECT — a new
# key in the same project shares the same quota. If you hit RESOURCE_EXHAUSTED,
# switch to a model with an unused daily bucket, e.g.:
#   GEMINI_CHAT_MODEL=gemini-3-flash-preview
#   GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# and restart the server (.env is read at startup only).
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=models/gemini-embedding-001
